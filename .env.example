# Environment Configuration Template
# Copy this file to .env and fill in your actual values

# ===================================
# Korea Investment & Securities API
# ===================================
# Get credentials from: https://apiportal.koreainvestment.com/
KIS_APP_KEY=your_app_key_here
KIS_APP_SECRET=your_app_secret_here
KIS_ACCOUNT_NUMBER=12345678-01       # Format: 8digits-2digits

# API Domain (auto-selected based on MODE)
# - Development/Paper Mode: Virtual trading domain
# - Production/Live Mode: Real trading domain
# You can override by setting KIS_BASE_URL manually
KIS_BASE_URL_DEV=https://openapivts.koreainvestment.com:29443
KIS_BASE_URL_PROD=https://openapi.koreainvestment.com:9443

# API Version
KIS_API_VERSION=v1

# ===================================
# OpenAI API
# ===================================
# Get API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# ===================================
# Supabase Database
# ===================================
# Get from your Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-key-here

# ===================================
# Trading Configuration
# ===================================
# Mode: paper (simulation) | live (real trading) | backtest
MODE=paper

# Risk Management
MAX_POSITION_WEIGHT=0.20          # Max 20% per stock
MAX_TOTAL_INVESTMENT=0.80         # Max 80% total investment
MIN_CASH_RESERVE=0.20             # Min 20% cash
STOP_LOSS_PCT=-0.03               # -3% stop loss
MIN_CONFIDENCE_TO_TRADE=0.6       # Min AI confidence 60%

# Trading Limits
MAX_TRADES_PER_BATCH=10           # Max orders per batch
MIN_ORDER_AMOUNT=100000           # Min 100,000 KRW per order

# ===================================
# Batch Scheduling (Cron Format)
# ===================================
# Format: "minute hour * * day"
# Example: "0 9 * * 1-5" = Every weekday at 09:00
BATCH_SCHEDULE_1=5 9 * * 1-5      # Monday-Friday 09:05
BATCH_SCHEDULE_2=30 10 * * 1-5    # Monday-Friday 10:30
BATCH_SCHEDULE_3=30 13 * * 1-5    # Monday-Friday 13:30
BATCH_SCHEDULE_4=0 15 * * 1-5     # Monday-Friday 15:00

# ===================================
# Server Configuration
# ===================================
PORT=3000
NODE_ENV=development

# ===================================
# Logging
# ===================================
LOG_LEVEL=INFO                     # DEBUG | INFO | WARN | ERROR | CRITICAL

# ===================================
# Overseas Trading (해외 거래)
# ===================================
ENABLE_OVERSEAS_TRADING=true          # Enable overseas stock trading
SUPPORTED_MARKETS=US,HK,JP,CN         # Markets: US, HK, JP, CN

# Currency Exposure Limits
MAX_CURRENCY_EXPOSURE_USD=0.30        # Max 30% in USD assets
MAX_CURRENCY_EXPOSURE_HKD=0.20        # Max 20% in HKD assets
MAX_CURRENCY_EXPOSURE_JPY=0.15        # Max 15% in JPY assets
MAX_CURRENCY_EXPOSURE_CNY=0.10        # Max 10% in CNY assets

# Market-specific Position Limits
MAX_OVERSEAS_POSITION_WEIGHT=0.15     # Max 15% per overseas stock
MAX_OVERSEAS_TOTAL_INVESTMENT=0.50    # Max 50% total overseas investment

# ===================================
# Feature Flags
# ===================================
ENABLE_SCHEDULER=true              # Enable cron scheduling
ENABLE_DISCORD_ALERTS=false        # Send alerts to Discord
DISCORD_WEBHOOK_URL=               # Discord webhook URL (optional)
