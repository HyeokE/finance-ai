# Environment Configuration Template
# Copy this file to .env and fill in your actual values

# ===================================
# Korea Investment & Securities API
# ===================================
# Get credentials from: https://apiportal.koreainvestment.com/
KIS_APP_KEY=your_app_key_here
KIS_APP_SECRET=your_app_secret_here
KIS_ACCOUNT_NUMBER=12345678-01       # Format: 8digits-2digits

# API Domain (auto-selected based on MODE)
# - Development/Paper Mode: Virtual trading domain
# - Production/Live Mode: Real trading domain
# You can override by setting KIS_BASE_URL manually
KIS_BASE_URL_DEV=https://openapivts.koreainvestment.com:29443
KIS_BASE_URL_PROD=https://openapi.koreainvestment.com:9443

# API Version
KIS_API_VERSION=v1

# ===================================
# AI Provider Configuration
# ===================================
# AI_PROVIDER: openai | gemini (default: openai)
AI_PROVIDER=openai

# OpenAI API (only needed if AI_PROVIDER=openai)
# Get API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o                     # gpt-4o | gpt-4o-mini | gpt-5.1 | o1-preview | o1-mini

# Google Gemini API (only needed if AI_PROVIDER=gemini)
# Get API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash-exp       # gemini-2.0-flash-exp | gemini-1.5-pro | gemini-1.5-flash

# ===================================
# Supabase Database
# ===================================
# Get from your Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-key-here

# ===================================
# Trading Configuration
# ===================================
# Mode: paper (simulation) | live (real trading) | backtest
MODE=paper

# NOTE: Risk management and batch scheduling settings are now configured
# via the Dashboard UI and stored in Supabase (market_batch_settings, market_risk_settings)
# See: http://localhost:5173 (dashboard)

# ===================================
# Server Configuration
# ===================================
PORT=3000
NODE_ENV=development


# ===================================
# Logging
# ===================================
LOG_LEVEL=INFO                     # DEBUG | INFO | WARN | ERROR | CRITICAL

# ===================================
# Feature Flags
# ===================================
ENABLE_SCHEDULER=true              # Enable cron scheduling
ENABLE_DISCORD_ALERTS=false        # Send alerts to Discord
DISCORD_WEBHOOK_URL=               # Discord webhook URL (optional)
