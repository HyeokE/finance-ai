{
  "name": "auto-finance",
  "version": "1.0.0",
  "description": "Auto Finance - AI-Powered Multi-Market Trading Bot",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "build:backend": "pnpm --filter @auto-finance/backend build",
    "build:dashboard": "pnpm --filter @auto-finance/dashboard build",
    "dev:backend": "pnpm --filter @auto-finance/backend dev",
    "dev:dashboard": "pnpm --filter @auto-finance/dashboard dev",
    "start:backend": "pnpm --filter @auto-finance/backend start",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r exec rm -rf dist node_modules"
  },
  "keywords": [
    "trading",
    "ai",
    "automation",
    "korea",
    "finance"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}